/* --- App base --- */
QMainWindow {
    background-color: #23262b;
}

QWidget {
    color: #e6e6e6;
    font-size: 18px;
}

/* --- Title label --- */
QLabel#title {
    font-size: 20px;
    font-weight: 700;
    color: #e6e6e6;
}

/* --- Cards / group boxes --- */
QGroupBox {
    background-color: #2b2f36;
    border: 1px solid #3a3f47;
    border-radius: 10px;
    margin-top: 12px;
    padding: 12px;
    font: bold;
    color: #5fb3b3;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    margin-left: 2px;
}

QLabel#header_label {
    font-weight: bold;
    font-size: 19px;
    color: #5fb3b3;
}

/* --- Inputs --- */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #1c1f24;
    border: 1px solid #3a3f47;
    border-radius: 8px;
    padding: 6px 12px;
    color: #e6e6e6;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #5fb3b3;
}

QLineEdit:placeholder {
    color: #8e96a3;
}

/* Make spinboxes look cleaner */
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    width: 16px;
    border: none;
    background: transparent;
}

/* --- Checkboxes --- */
QCheckBox {
    spacing: 6px;
    padding: 1px 0;
    color: #dfe4ea;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    border: 1px solid #5b616c;
    background-color: #1c1f24;
}

QCheckBox::indicator:hover {
    border: 1px solid #7faeb3;
}

QCheckBox::indicator:checked {
    background-color: #5fb3b3;
    border: 1px solid #5fb3b3;
}

QCheckBox::indicator:checked:hover {
    background-color: #6fd0d0;
}

/* --- Console --- */
QTextEdit {
    background-color: #111316;
    color: #cbd5e1;
    border: 1px solid #3a3f47;
    border-radius: 10px;
    padding: 10px;
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 16px;
}

QTextEdit:focus {
    border: 1px solid #5fb3b3;
}

/* --- Buttons --- */
QPushButton {
    font-weight: 700;
    font-size: 18px;
    padding: 10px 16px;
    border-radius: 10px;
    color: white;
    border: 1px solid transparent;
}

QPushButton:hover {
    opacity: 0.95;
}

QPushButton:pressed {
    opacity: 0.88;
}

/* Primary */
QPushButton#run_btn {
    background-color: #2d8a4e;
    border: 1px solid #3eaf68;
}

QPushButton#run_btn:hover { background-color: #39a760; }
QPushButton#run_btn:pressed { background-color: #257242; }
QPushButton#run_btn:disabled {
    background-color: #39413d;
    border: 1px solid #39413d;
    color: #8a8f96;
}

/* Data Processing */
QPushButton#process_data_btn {
    background-color: #5050cf;
    border: 1px solid #1e1a72;
}

QPushButton#process_data_btn:hover { background-color: #666ea5; }
QPushButton#process_data_btn:pressed { background-color: #252274; }
QPushButton#process_data_btn:disabled {
    background-color: #39413d;
    border: 1px solid #39413d;
    color: #8a8f96;
}

/* Danger */
QPushButton#cancel_btn {
    background-color: #b33a3a;
    border: 1px solid #d44c4c;
}

QPushButton#cancel_btn:hover { background-color: #d44c4c; }
QPushButton#cancel_btn:pressed { background-color: #952f2f; }
QPushButton#cancel_btn:disabled {
    background-color: #3e2f2f;
    border: 1px solid #3e2f2f;
    color: #8a8f96;
}


/* Neutral */
QPushButton#exit_btn {
    background-color: #3c4048;
    border: 1px solid #515763;
}

QPushButton#exit_btn:hover { background-color: #515763; }
QPushButton#exit_btn:pressed { background-color: #2f333a; }

/* Smaller “browse” buttons */
QPushButton#browse_btn {
    font-size: 18px;
    padding: 6px 6px;
    font-weight: 600;
    background-color: #357575;
    border: 1px solid #515763;
    min-width: 150px;
    max-width: 150px;
    min-height: 20px;
}
QPushButton#browse_btn:hover { background-color: #316363; }
QPushButton#browse_btn:pressed { background-color: #3f434a; }

/* --- Group assignment dialog --- */
QDialog#group_assignment_dialog {
    background-color: #20262d;
    color: #f4f7f8;
}

QDialog#group_assignment_dialog QLabel#group_dialog_title {
    color: #f4f7f8;
    font-size: 25px;
    font-weight: 700;
}

QDialog#group_assignment_dialog QLabel#group_dialog_instruction {
    color: #b8c3c9;
    font-size: 15px;
}

QDialog#group_assignment_dialog QFrame#group_dialog_context,
QDialog#group_assignment_dialog QFrame#group_dialog_assignments {
    background-color: #29323a;
    border: 1px solid #43515c;
    border-radius: 10px;
}

QDialog#group_assignment_dialog QLabel#group_dialog_context_label {
    color: #9fb0ba;
    font-size: 14px;
    font-weight: 600;
}

QDialog#group_assignment_dialog QLabel#group_dialog_context_value {
    color: #f4f7f8;
    font-size: 15px;
    font-weight: 600;
}

QDialog#group_assignment_dialog QLabel#group_dialog_section_title {
    color: #78c9c8;
    font-size: 17px;
    font-weight: 700;
}

QDialog#group_assignment_dialog QScrollArea#group_dialog_scroll,
QDialog#group_assignment_dialog QWidget#group_dialog_content {
    background: transparent;
    border: none;
}

QDialog#group_assignment_dialog QLabel#group_dialog_column_header {
    color: #d8e2e6;
    background-color: #20262d;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 700;
    padding: 7px 10px;
}

QDialog#group_assignment_dialog QLineEdit#group_dialog_input,
QDialog#group_assignment_dialog QSpinBox#group_dialog_input {
    background-color: #151a1f;
    border: 1px solid #52616c;
    border-radius: 7px;
    color: #f4f7f8;
    font-size: 16px;
    padding: 7px 10px;
}

QDialog#group_assignment_dialog QLineEdit#group_dialog_input:hover,
QDialog#group_assignment_dialog QSpinBox#group_dialog_input:hover {
    border-color: #78aeb0;
}

QDialog#group_assignment_dialog QLineEdit#group_dialog_input:focus,
QDialog#group_assignment_dialog QSpinBox#group_dialog_input:focus {
    border: 2px solid #78c9c8;
}

QDialog#group_assignment_dialog QLineEdit#group_dialog_input:placeholder {
    color: #9aaab3;
}

QDialog#group_assignment_dialog QPushButton#group_dialog_continue,
QDialog#group_assignment_dialog QPushButton#group_dialog_cancel {
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    min-width: 120px;
    padding: 8px 16px;
}

QDialog#group_assignment_dialog QPushButton#group_dialog_continue {
    background-color: #187a7a;
    border: 1px solid #78c9c8;
    color: #ffffff;
}

QDialog#group_assignment_dialog QPushButton#group_dialog_continue:hover {
    background-color: #1c8585;
}

QDialog#group_assignment_dialog QPushButton#group_dialog_continue:pressed {
    background-color: #126565;
}

QDialog#group_assignment_dialog QPushButton#group_dialog_cancel {
    background-color: #36434d;
    border: 1px solid #73838e;
    color: #f4f7f8;
}

QDialog#group_assignment_dialog QPushButton#group_dialog_cancel:hover {
    background-color: #465660;
}

QDialog#group_assignment_dialog QPushButton#group_dialog_cancel:pressed {
    background-color: #2a353d;
}

QDialog#group_assignment_dialog QPushButton#group_dialog_continue:focus,
QDialog#group_assignment_dialog QPushButton#group_dialog_cancel:focus {
    border: 2px solid #f0c36b;
}
