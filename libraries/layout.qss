/* --- App base --- */
QMainWindow {
    background-color: #23262b;
}

QWidget {
    color: #e6e6e6;
    font-size: 18px;
}

/* --- Title label --- */
QLabel#title {
    font-size: 20px;
    font-weight: 700;
    color: #e6e6e6;
}

/* --- Cards / group boxes --- */
QGroupBox {
    background-color: #2b2f36;
    border: 1px solid #3a3f47;
    border-radius: 10px;
    margin-top: 12px;
    padding: 12px;
    font: bold;
    color: #5fb3b3;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    margin-left: 2px;
}

QComboBox {
    background-color: #1c1f24;
    border: 1px solid #3a3f47;
    border-radius: 8px;
    padding: 6px 12px;
    color: #e6e6e6;
}

QLabel#header_label {
    font-weight: bold;
    font-size: 19px;
    color: #5fb3b3;
}

QLabel#group_assignment_label {
    font-weight: 600;
    font-style: italic;
    color: #e6e6e6;
}

/* Replicates label style (if used elsewhere) */
QLabel#replicates_label {
    font-weight: 600;
    font-style: italic;
    color: #e6e6e6;
}
/* --- Inputs --- */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #1c1f24;
    border: 1px solid #3a3f47;
    border-radius: 8px;
    padding: 6px 12px;
    color: #e6e6e6;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #5fb3b3;
}

QLineEdit:placeholder {
    color: #8e96a3;
}

QLineEdit[same_as_above_locked="true"] {
    background-color: #2a2a2a;
    color: #9aa0a6;
}


/* Make spinboxes look cleaner */
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    width: 16px;
    border: none;
    background: transparent;
}

/* --- Checkboxes --- */
QCheckBox {
    spacing: 6px;
    padding: 1px 0;
    color: #dfe4ea;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    border: 1px solid #5b616c;
    background-color: #1c1f24;
}

QCheckBox::indicator:hover {
    border: 1px solid #7faeb3;
}

QCheckBox::indicator:checked {
    background-color: #5fb3b3;
    border: 1px solid #5fb3b3;
}

QCheckBox::indicator:checked:hover {
    background-color: #6fd0d0;
}

/* --- Console --- */
QTextEdit {
    background-color: #111316;
    color: #cbd5e1;
    border: 1px solid #3a3f47;
    border-radius: 10px;
    padding: 10px;
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 16px;
}

QTextEdit:focus {
    border: 1px solid #5fb3b3;
}

/* --- Buttons --- */
QPushButton {
    font-weight: 700;
    font-size: 18px;
    padding: 10px 16px;
    border-radius: 10px;
    color: white;
    border: 1px solid transparent;
}

QPushButton:hover {
    opacity: 0.95;
}

QPushButton:pressed {
    opacity: 0.88;
}

/* Primary */
QPushButton#run_btn {
    background-color: #2d8a4e;
    border: 1px solid #3eaf68;
}

QPushButton#run_btn:hover { background-color: #39a760; }
QPushButton#run_btn:pressed { background-color: #257242; }
QPushButton#run_btn:disabled {
    background-color: #39413d;
    border: 1px solid #39413d;
    color: #8a8f96;
}

/* Danger */
QPushButton#cancel_btn {
    background-color: #b33a3a;
    border: 1px solid #d44c4c;
}

QPushButton#cancel_btn:hover { background-color: #d44c4c; }
QPushButton#cancel_btn:pressed { background-color: #952f2f; }
QPushButton#cancel_btn:disabled {
    background-color: #3e2f2f;
    border: 1px solid #3e2f2f;
    color: #8a8f96;
}

QPushButton#process_data_btn:hover { background-color: #72F3F3; }
QPushButton#process_data_btn:pressed { background-color: #72F3F3; }
QPushButton#process_data_btn:disabled {
    background-color: #39413d;
    border: 1px solid #39413d;
    color: #8a8f96;
}

/* Neutral */
QPushButton#exit_btn {
    background-color: #3c4048;
    border: 1px solid #515763;
}

QPushButton#exit_btn:hover { background-color: #515763; }
QPushButton#exit_btn:pressed { background-color: #2f333a; }

/* Smaller “browse” buttons */
QPushButton#browse_btn {
    font-size: 18px;
    padding: 6px 6px;
    font-weight: 600;
    background-color: #357575;
    border: 1px solid #515763;
    min-width: 150px;
    max-width: 150px;
    min-height: 20px;
}
QPushButton#browse_btn:hover { background-color: #316363; }
QPushButton#browse_btn:pressed { background-color: #3f434a; }